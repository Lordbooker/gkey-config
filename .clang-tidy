#
# Checked in CI (see CONTRIBUTING.md). Switched off:
# * checks that only enforce a style this project does not use: braces around
#   single statements (also in if/else chains), [[nodiscard]] everywhere,
#   #pragma once, trailing commas, designated initialisers, enum sizes, names
#   for unused parameters, implicit pointer-to-bool tests as usual with Qt,
#   const on every local variable;
# * checks that do not fit Qt: include-cleaner (Qt's headers), exceptions from
#   static QString initialisation, access specifiers repeated for "slots:",
#   protected overrides of public event handlers, member functions that could
#   be static (slots and API of QObject classes), pass-by-value (Qt types are
#   implicitly shared, a copy only counts a reference).
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-throwing-static-initialization,
  -cert-err58-cpp,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-override-with-different-visibility,
  -misc-const-correctness,
  -modernize-avoid-c-arrays,
  -modernize-use-designated-initializers,
  -modernize-pass-by-value,
  -modernize-use-nodiscard,
  -modernize-use-trailing-return-type,
  -performance-enum-size,
  -portability-avoid-pragma-once,
  -readability-braces-around-statements,
  -readability-convert-member-functions-to-static,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-inconsistent-ifelse-braces,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -readability-named-parameter,
  -readability-redundant-access-specifiers,
  -readability-trailing-comma
WarningsAsErrors: '*'
HeaderFilterRegex: '/(src|tests)/'
# Code generated by moc
ExcludeHeaderFilterRegex: '_autogen/'
