#
# Tests: Qt Test classes are found through moc (internal linkage does not
# apply), and QVERIFY() ends a test function, which the optional check does not
# see (it reports every access after QVERIFY(value)).
InheritParentConfig: true
Checks: >
  -bugprone-unchecked-optional-access,
  -misc-use-internal-linkage
