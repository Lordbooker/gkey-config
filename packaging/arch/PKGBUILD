# Maintainer: Lordbooker <lordbooker@gmail.com>
# Skeleton for milestone 1; the AUR package follows in milestone 8.

pkgname=gkey-config-git
pkgver=r0
pkgrel=1
pkgdesc="Configuration tool for the gaming keys of Logitech G keyboards (hid-lg-g15)"
arch=('x86_64')
url="https://github.com/Lordbooker/gkey-config"
license=('GPL-2.0-only')
depends=('qt6-base' 'libevdev' 'systemd-libs' 'systemd')
makedepends=('cmake' 'git' 'pkgconf' 'qt6-tools')
provides=('gkey-config')
conflicts=('gkey-config' 'linux-g13-driver' 'linux-g13-driver-git')
install=gkey-config.install
source=("gkey-config::git+https://github.com/Lordbooker/gkey-config.git#branch=dev")
sha256sums=('SKIP')

pkgver() {
    cd gkey-config
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cmake -S gkey-config -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTS=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
