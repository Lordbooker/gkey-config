# Group "gkey" for LED access (sysusers.d/gkey-config.conf).
if command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers gkey-config.conf || :
fi
# Apply the udev rule to devices that are already connected.
if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || :
    udevadm trigger --subsystem-match=input --subsystem-match=hidraw --subsystem-match=misc || :
    udevadm trigger --action=add --subsystem-match=leds || :
fi
if [ "$1" -eq 1 ]; then
    echo "gkey-config: to allow LED control, add your user to the group 'gkey':"
    echo "  sudo usermod -aG gkey \$USER   (then log out and back in)"
    echo "gkey-config: enable the daemon as your normal user:"
    echo "  systemctl --user enable --now gkeyd"
fi
